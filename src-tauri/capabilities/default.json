{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "知录默认权限",
  "windows": ["main", "hud", "picker"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:default",
    "opener:default",
    "updater:default",
    "process:default",
    {
      "identifier": "core:webview:allow-internal-toggle-devtools",
      "allow": []
    }
  ]
}
